<!doctype html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root{--emerald:#0b6b52;--gold:#c99a3b}
      body{font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;padding:28px;background:linear-gradient(180deg,#f7fbfa,#eef6f4)}
      header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
      h1{font-family:'Playfair Display', Georgia, serif;margin:0;color:#072a22}
      .logout{color:var(--emerald);text-decoration:none;font-weight:600}
      .card{background:linear-gradient(180deg,rgba(255,255,255,0.95),rgba(255,255,250,0.95));padding:18px;border-radius:12px;border:1px solid rgba(11,107,82,0.06);box-shadow:0 8px 20px rgba(10,30,20,0.06)}
      table{width:100%;border-collapse:collapse;margin-top:12px;background:transparent}
      thead th{background:transparent;text-align:left;padding:12px 10px;color:#234b42;font-weight:700}
      tbody td{padding:14px 10px;border-top:1px solid rgba(11,107,82,0.06);vertical-align:top}
      .name-col{width:220px;font-weight:600;color:#07332b}
      pre{white-space:pre-wrap;font-family:Menlo,Monaco,monospace;background:transparent;border:none;margin:0;color:#243a36}
      .error{margin:12px 0 0;color:#8b1d1d;background:rgba(139,29,29,0.04);padding:10px;border-radius:8px}
      @media (max-width:720px){body{padding:16px}.name-col{width:140px}}
    </style>
  </head>
  <body>
    <header>
      <div style="display:flex;align-items:center;gap:14px">
        <div style="width:56px;height:56px;border-radius:10px;overflow:hidden;border:3px solid rgba(201,154,59,0.12)"><img src="/brand-logo.svg" style="width:100%;height:100%;display:block" alt="logo"></div>
        <div>
          <h1>Kai Nani - Admin</h1>
          <div>Welcome, <strong><%= user && user.email %></strong></div>
        </div>
      </div>
      <div><a class="logout" href="/admin/logout">Logout</a></div>
    </header>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <section>
      <h2>Properties</h2>
      <div class="tabs">
        <button class="tab" data-tab="weather">Weather</button>
        <button class="tab active" data-tab="spa">Featured: Spa</button>
        <button class="tab" data-tab="sound">Sound Bath</button>
        <button class="tab" data-tab="getaway">Getaway</button>
      </div>

      <div id="tab-weather" class="tab-panel" style="display:none">
        <h3>Wailea, Maui Weather</h3>
        <% if (weather) { %>
          <p><strong><%= weather.city %></strong> — <%= weather.summary %></p>
          <table>
            <thead><tr><th>Time</th><th>Temp (°C)</th><th>Rain (mm)</th><th>Pop</th></tr></thead>
            <tbody>
              <% weather.list.forEach(function(w){ %>
                <tr>
                  <td><%= w.dt_txt %></td>
                  <td><%= w.temp != null ? w.temp : '—' %></td>
                  <td><%= w.rain %></td>
                  <td><%= Math.round((w.pop||0)*100) %>%</td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p>No weather data — set `OPENWEATHER_API_KEY` in your environment to enable live forecast.</p>
        <% } %>
      </div>

      <div id="tab-spa" class="tab-panel">
        <h3>Featured Spa & Retreat</h3>
        <p>Experience our signature spa treatments including a spiritual sound bath and restorative getaways. Feature highlights:</p>
        <ul>
          <li>Sound bath sessions with native instruments</li>
          <li>Hydrotherapy and hot/cold circuits</li>
          <li>Couples' relaxation packages and meditation</li>
        </ul>
      </div>

      <div id="tab-sound" class="tab-panel" style="display:none">
        <h3>Spiritual Sound Bath</h3>
        <p>Guided sound bath sessions to restore balance and promote deep relaxation. Schedule and availability shown in admin features.</p>
      </div>

      <div id="tab-getaway" class="tab-panel" style="display:none">
        <h3>Getaway Packages</h3>
        <p>Curated getaway packages combining lodging, spa, and activities for a restful Maui experience.</p>
      </div>

      <table>
        <thead>
          <tr><th>Name</th><th>Details</th></tr>
        </thead>
        <tbody>
          <% properties.forEach(function(p){ %>
            <tr>
              <td><%= p.name || p.title || 'Untitled' %></td>
              <td><pre style="margin:0"><%= JSON.stringify(p, null, 2) %></pre></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <script>
      document.addEventListener('DOMContentLoaded', function(){
        const tabs = document.querySelectorAll('.tab');
        tabs.forEach(function(btn){
          btn.addEventListener('click', function(){
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            const name = btn.getAttribute('data-tab');
            document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
            const panel = document.getElementById('tab-' + name);
            if (panel) panel.style.display = '';
          });
        });
      });
    </script>
  </body>
</html>
