# Example environment variables for Kai Nani term project
# Copy to .env and fill with real values (do NOT commit .env)

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/kainani?retryWrites=true&w=majority
SESSION_SECRET=replace_this_with_a_long_random_secret
PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional (for connect-mongo)
MONGO_SESSION_TTL_DAYS=14
